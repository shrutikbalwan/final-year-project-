{
  "$defs": {
    "ConnectivityStatus": {
      "enum": [
        "connected",
        "disconnected",
        "intermittent",
        "unknown"
      ],
      "title": "ConnectivityStatus",
      "type": "string"
    },
    "LastSeenStatus": {
      "enum": [
        "valid",
        "missing",
        "stale"
      ],
      "title": "LastSeenStatus",
      "type": "string"
    },
    "ReadingStatus": {
      "enum": [
        "valid",
        "missing",
        "stale",
        "invalid"
      ],
      "title": "ReadingStatus",
      "type": "string"
    },
    "SensorReading": {
      "additionalProperties": false,
      "description": "One reported measurement with explicit unit and quality state.",
      "properties": {
        "reading_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Reading Id",
          "type": "string"
        },
        "sensor_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Sensor Id",
          "type": "string"
        },
        "measurement_type": {
          "description": "Stable quantity name, for example temperature or gas_concentration.",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Measurement Type",
          "type": "string"
        },
        "unit_code": {
          "description": "Machine-readable unit token; producers must document and use it consistently.",
          "maxLength": 32,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9%._/\\[\\]-]+$",
          "title": "Unit Code",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Finite measurement value, or null only when reading_status is missing.",
          "title": "Value"
        },
        "reading_status": {
          "$ref": "#/$defs/ReadingStatus"
        },
        "observed_at": {
          "description": "RFC 3339 timestamp in UTC, ending in Z or +00:00.",
          "format": "date-time",
          "pattern": "(?:Z|\\+00:00)$",
          "title": "Observed At",
          "type": "string"
        }
      },
      "required": [
        "reading_id",
        "sensor_id",
        "measurement_type",
        "unit_code",
        "value",
        "reading_status",
        "observed_at"
      ],
      "title": "SensorReading",
      "type": "object",
      "allOf": [
        {
          "if": {
            "properties": {
              "reading_status": {
                "const": "missing"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reading_status": {
                "enum": [
                  "valid",
                  "stale",
                  "invalid"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "number"
              }
            }
          }
        }
      ]
    }
  },
  "additionalProperties": false,
  "description": "Point-in-time device health, including explicit unknown/missing states.",
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "device_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Device Id",
      "type": "string"
    },
    "workplace_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Workplace Id",
      "type": "string"
    },
    "observed_at": {
      "description": "RFC 3339 timestamp in UTC, ending in Z or +00:00.",
      "format": "date-time",
      "pattern": "(?:Z|\\+00:00)$",
      "title": "Observed At",
      "type": "string"
    },
    "battery_reading": {
      "$ref": "#/$defs/SensorReading",
      "description": "Battery percentage reading; value is 0..100 when present, in unit_code %."
    },
    "connectivity_status": {
      "$ref": "#/$defs/ConnectivityStatus"
    },
    "last_seen_at": {
      "anyOf": [
        {
          "description": "RFC 3339 timestamp in UTC, ending in Z or +00:00.",
          "format": "date-time",
          "pattern": "(?:Z|\\+00:00)$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Most recent confirmed device contact, or null when not known.",
      "title": "Last Seen At"
    },
    "last_seen_status": {
      "$ref": "#/$defs/LastSeenStatus"
    }
  },
  "required": [
    "device_id",
    "workplace_id",
    "observed_at",
    "battery_reading",
    "connectivity_status",
    "last_seen_at",
    "last_seen_status"
  ],
  "title": "DeviceHealth",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smartsafetyhelmet.example/contracts/v1/device_health.schema.json",
  "allOf": [
    {
      "properties": {
        "battery_reading": {
          "properties": {
            "measurement_type": {
              "const": "battery_charge"
            },
            "unit_code": {
              "const": "%"
            },
            "value": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "last_seen_status": {
            "const": "missing"
          }
        }
      },
      "then": {
        "properties": {
          "last_seen_at": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "last_seen_status": {
            "enum": [
              "valid",
              "stale"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "last_seen_at": {
            "type": "string"
          }
        }
      }
    }
  ]
}
